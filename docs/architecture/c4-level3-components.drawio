        <mxCell id="bandA" value="Приложение compose (client3/web/compose/src)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#777777;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fontStyle=2;" vertex="1" parent="1">
