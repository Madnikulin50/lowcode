        </mxCell>
        <mxCell id="backend" value="&lt;b&gt;Backend&lt;/b&gt;&lt;br&gt;&lt;br&gt;UseSync — чистая функция,&lt;br&gt;ответ сразу&lt;br&gt;UseAsync — горутина,&lt;br&gt;SetProgress / SetItems&lt;br&gt;custom Backend (backup:&lt;br&gt;состояние джоб в домене)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#5d82b8;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="140" y="560" width="380" height="170" as="geometry" />
        </mxCell>
        <mxCell id="domain" value="&lt;b&gt;Домен агента&lt;/b&gt;&lt;br&gt;&lt;br&gt;сканер сети · движок бэкапа (restic/kopia, SMB/БД/S3) ·&lt;br&gt;растеризация PDF (стройконтроль) ·&lt;br&gt;LLM-классификация (cmdb)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#5d82b8;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="140" y="780" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="job" value="&lt;b&gt;Job&lt;/b&gt;&lt;br&gt;&lt;br&gt;Envelope lowcode.agent.v1: status/kind,&lt;br&gt;progress (троттлинг 2 с), items, result;&lt;br&gt;финальный complete/failed →&lt;br&gt;callbackUrl (timeout 90 с)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#5d82b8;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="560" width="440" height="170" as="geometry" />
        </mxCell>
        <mxCell id="auth" value="&lt;b&gt;SelfToken&lt;/b&gt;&lt;br&gt;&lt;br&gt;TOKEN из env · иначе&lt;br&gt;AGENT_SHARED_SECRET →&lt;br&gt;POST /agents/enroll (X-Agent-Secret)&lt;br&gt;→ JWT corteza-service, 365 дней" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#5d82b8;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
