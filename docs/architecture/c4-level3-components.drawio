        <mxCell id="sdk" value="&lt;b&gt;sdk.Service&lt;/b&gt; [chi]&lt;br&gt;&lt;br&gt;GET /health · GET /api/meta (дескрипторы операций → палитра rule chains)&lt;br&gt;POST /api/jobs · GET /api/jobs/{id}[/items] · POST /api/call/{op} · POST /api/register" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#5d82b8;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
